# Copy to backend/.env (gitignored; never commit it). Every setting is optional.
# Put real keys ONLY in backend/.env - this file is tracked by git and gets pushed.
# backend/.env is loaded automatically and never overrides variables already set in your shell.

# --- Swale ---
SWALE_DB_URL=surrealkv://var/swale.db        # mem:// for throwaway runs; ws://host:port for a SurrealDB server
SWALE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SWALE_DEV_MAP=1
SWALE_SOCRATA_APP_TOKEN=                      # optional; raises NYC Open Data rate limits

# --- Simulation sandbox (Daytona) ---
DAYTONA_API_KEY=

# --- AI briefing (AWS Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                            # only for temporary credentials
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=                     # alternative to the three above: a Bedrock API key

# --- Tracing and evals (Arize) ---
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# --- Spoken briefing (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                          # optional; a default voice is used when empty
